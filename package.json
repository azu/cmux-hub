{
  "name": "cmux-hub",
  "version": "1.6.1",
  "private": true,
  "bin": {
    "cmux-hub": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/cli.ts -p 4567 --actions .claude/cmux-hub.json .",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "build:compile": "bun run build-compile.ts",
    "test": "bun test src server",
    "lint": "oxlint .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "bun run --bun tsc --noEmit",
    "test:e2e": "bunx playwright test e2e/smoke.spec.ts",
    "screenshots": "bunx playwright test e2e/screenshots.spec.ts",
    "version:sync-plugin": "node scripts/sync-plugin-version.js",
    "version": "node scripts/sync-plugin-version.js && git add cmux-hub-plugin/.claude-plugin/plugin.json",
    "version:patch": "npm version patch --ignore-scripts=false && git push && git push --tags",
    "version:minor": "npm version minor --ignore-scripts=false && git push && git push --tags",
    "version:major": "npm version major --ignore-scripts=false && git push && git push --tags",
    "prepare": "git config --local core.hooksPath .githooks || echo 'Can not set git hooks'"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-grab": "0.1.28",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
